From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Active ESL Engineering <engineering@active-esl.com>
Date: Wed, 16 Sep 2026 20:00:00 +0000
Subject: [PATCH] init: do not remount LXC-owned first-stage filesystems

Waydroid's LXC configuration mounts /dev, /dev/pts and /proc before Android
init starts. Android 16's Waydroid patch changed their first-stage mounts
into remounts, but they still fail inside the container. CHECKCALL then makes
first-stage init abort before the Binder service manager can start.

Keep the host-provided mounts, as earlier Waydroid init patches did, while
retaining the directory setup that Android needs.
---
 init/first_stage_init.cpp | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/init/first_stage_init.cpp b/init/first_stage_init.cpp
--- a/init/first_stage_init.cpp
+++ b/init/first_stage_init.cpp
@@ -378,12 +378,9 @@ int FirstStageMain(int argc, char** argv) {
     // Get the basic filesystem setup we need put together in the initramdisk
     // on / and then we'll let the rc file figure out the rest.
-    CHECKCALL(mount("tmpfs", "/dev", "tmpfs", MS_REMOUNT | MS_NOSUID, "mode=0755"));
+    // LXC has already mounted /dev, /dev/pts and /proc for Waydroid.
+    // Remounting them here fails and aborts first-stage init.
     CHECKCALL(MKDIR_IF_NOT_EXIST("/dev/pts", 0755));
     CHECKCALL(MKDIR_IF_NOT_EXIST("/dev/socket", 0755));
     CHECKCALL(MKDIR_IF_NOT_EXIST("/dev/dm-user", 0755));
-    CHECKCALL(mount("devpts", "/dev/pts", "devpts", MS_REMOUNT, NULL));
-#define MAKE_STR(x) __STRING(x)
-    CHECKCALL(mount("proc", "/proc", "proc", MS_REMOUNT, "hidepid=2,gid=" MAKE_STR(AID_READPROC)));
-#undef MAKE_STR
     std::string cmdline;
    android::base::ReadFileToString("/proc/cmdline", &cmdline);
