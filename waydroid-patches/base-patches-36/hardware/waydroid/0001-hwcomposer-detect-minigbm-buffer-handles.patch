From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Active ESL Engineering <engineering@active-esl.com>
Date: Fri, 11 Sep 2026 12:20:00 +0100
Subject: [PATCH] hwcomposer: Detect minigbm buffer handles

Android 16's AIDL allocator supplies cros_gralloc_handle buffers even when
the Waydroid 1.6 host property still reports ro.hardware.gralloc=gbm. Casting
those buffers as legacy gralloc_handle_t reads strides[0] as the HAL format;
the aligned byte strides then reach Wayland as invalid formats and disconnect
the compositor client.

Validate the legacy GBM magic and version before selecting its layout. Fall
back to the minigbm layout when the property and the actual handle disagree.
This preserves legacy GBM compatibility while allowing Android 16 AIDL
allocator buffers to retain their DRM fourcc and modifier metadata.
---
 hwcomposer/gralloc_handler.cpp | 37 ++++++++++++++++++++++++------------
 1 file changed, 25 insertions(+), 12 deletions(-)

diff --git a/hwcomposer/gralloc_handler.cpp b/hwcomposer/gralloc_handler.cpp
index 2fb2d3c7cb8db9d8ec4843e3d794a7199917d160..80aa21a8fdd12c1c86966799167516f5c2916897 100644
--- a/hwcomposer/gralloc_handler.cpp
+++ b/hwcomposer/gralloc_handler.cpp
@@ -280,36 +280,49 @@ buffer_metadata get_buffer_metadata_generic(display *display, hwc_layer_1_t *lay
 
     return {height, width, pixel_stride, format};
 }
-buffer_metadata get_buffer_metadata_gbm(display *, hwc_layer_1_t *layer, size_t) {
-    auto handle = reinterpret_cast<const gralloc_handle_t *>(layer->handle);
+buffer_metadata get_buffer_metadata_cros(display *, hwc_layer_1_t *layer, size_t) {
+    auto handle = reinterpret_cast<const cros_gralloc_handle *>(layer->handle);
     return {
             handle->height,
             handle->width,
-            handle->stride,
-            handle->format
+            handle->pixel_stride,
+            static_cast<uint32_t>(handle->droid_format)
     };
 }
-buffer_metadata get_buffer_metadata_cros(display *, hwc_layer_1_t *layer, size_t) {
-    auto handle = reinterpret_cast<const cros_gralloc_handle *>(layer->handle);
+bool is_gbm_handle(buffer_handle_t handle) {
+    auto drm_handle = reinterpret_cast<const gralloc_handle_t *>(handle);
+    return drm_handle->magic == GRALLOC_HANDLE_MAGIC &&
+            drm_handle->version == GRALLOC_HANDLE_VERSION;
+}
+buffer_metadata get_buffer_metadata_gbm(display *display, hwc_layer_1_t *layer, size_t pos) {
+    if (!is_gbm_handle(layer->handle))
+        return get_buffer_metadata_cros(display, layer, pos);
+
+    auto handle = reinterpret_cast<const gralloc_handle_t *>(layer->handle);
     return {
             handle->height,
             handle->width,
-            handle->pixel_stride,
-            static_cast<uint32_t>(handle->droid_format)
+            handle->stride,
+            handle->format
     };
 }
 
 std::unique_ptr<buffer> create_buffer_generic(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
     return create_shm_wl_buffer(conn, metadata, handle);
 }
-std::unique_ptr<buffer> create_buffer_gbm(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
-    auto *drm_handle = reinterpret_cast<const gralloc_handle_t *>(handle);
-    return create_dmabuf_wl_buffer(conn, metadata, drm_handle->prime_fd, -1 /* compute drm format */, drm_handle->stride, 0 /* offset */, drm_handle->modifier, handle);
-}
 std::unique_ptr<buffer> create_buffer_cros(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
     auto *cros_handle = reinterpret_cast<const cros_gralloc_handle *>(handle);
     return create_dmabuf_wl_buffer(conn, metadata, cros_handle->fds[0], cros_handle->format, cros_handle->strides[0], cros_handle->offsets[0], cros_handle->format_modifier, handle);
 }
+std::unique_ptr<buffer> create_buffer_gbm(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
+    if (!is_gbm_handle(handle)) {
+        ALOGW("ro.hardware.gralloc reports gbm but buffer uses minigbm handle layout");
+        return create_buffer_cros(conn, metadata, handle);
+    }
+
+    auto *drm_handle = reinterpret_cast<const gralloc_handle_t *>(handle);
+    return create_dmabuf_wl_buffer(conn, metadata, drm_handle->prime_fd, -1 /* compute drm format */, drm_handle->stride, 0 /* offset */, drm_handle->modifier, handle);
+}
 std::unique_ptr<buffer> create_buffer_android(wl_conn *conn, const buffer_metadata& metadata, buffer_handle_t handle) {
     return create_android_wl_buffer(conn, metadata, handle);
 }
-- 
