@@ -25,4 +25,9 @@
     <!-- The device supports freeform window management -->
     <bool name="config_freeformWindowManagement">true</bool>
 
+    <!-- AESL Jaguar is a single-application 2 GB appliance. Bound cached
+         processes and avoid retaining task snapshot graphics in RAM. -->
