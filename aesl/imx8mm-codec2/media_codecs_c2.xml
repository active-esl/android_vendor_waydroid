<?xml version="1.0" encoding="utf-8" ?>
<!-- NXP i.MX8MM Hantro decoder exposed through the stateful V4L2 API. -->
<MediaCodecs>
    <Decoders>
        <MediaCodec name="c2.v4l2.avc.decoder" type="video/avc">
            <Limit name="size" min="48x48" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-489600" />
            <Limit name="bitrate" range="1-62500000" />
            <Limit name="concurrent-instances" max="1" />
            <Limit name="performance-point-1920x1080" range="60-60" />
            <Feature name="adaptive-playback" />
        </MediaCodec>
    </Decoders>
</MediaCodecs>
